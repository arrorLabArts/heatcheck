server {
    listen 80;
    listen [::]:80;
    server_name heatcheck.dogi.watch storage.heatcheck.dogi.watch;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name heatcheck.dogi.watch;

    ssl_certificate /etc/letsencrypt/live/heatcheck.dogi.watch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heatcheck.dogi.watch/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 40s;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name storage.heatcheck.dogi.watch;

    ssl_certificate /etc/letsencrypt/live/storage.heatcheck.dogi.watch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/storage.heatcheck.dogi.watch/privkey.pem;

    client_max_body_size 100m;
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
