# Production deployment configuration. Copy this file to .env and fill every
# empty secret before running Docker Compose.
APP_ENV=production
API_HOST_PORT=8088

POSTGRES_DB=heatcheck
POSTGRES_USER=heatcheck
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=
BOOTSTRAP_ADMIN_EMAILS=
MAX_UPLOAD_BYTES=104857600
MINIMUM_AGE=18
UPLOAD_URL_TTL=15m

MINIO_ROOT_USER=heatcheck-minio-admin
MINIO_ROOT_PASSWORD=

# S3-compatible storage. Endpoint values do not include http:// or https://.
S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=storage.heatcheck.dogi.watch
S3_ACCESS_KEY=heatcheck-api
S3_SECRET_KEY=
S3_BUCKET=heatcheck-clips
S3_REGION=us-east-1
S3_INTERNAL_USE_SSL=false
S3_PUBLIC_USE_SSL=true
