# Production deployment configuration. Copy this file to .env and fill every
# empty secret before running Docker Compose.
APP_ENV=production
API_HOST_PORT=8088
PUBLIC_APP_URL=https://heatcheck.dogi.watch

POSTGRES_DB=heatcheck
POSTGRES_USER=heatcheck
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
# Keep the named volume or set an absolute mounted block-storage path.
POSTGRES_DATA_PATH=postgres-data

# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
ACCOUNT_EXPORT_TTL=24h
ACCOUNT_DELETE_GRACE_PERIOD=168h
ORIGINAL_MEDIA_RETENTION=720h
CORS_ALLOWED_ORIGINS=
# Only these reverse proxies may supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
BOOTSTRAP_ADMIN_EMAILS=
MAX_UPLOAD_BYTES=104857600
MINIMUM_AGE=18
UPLOAD_URL_TTL=15m
SUBMISSION_RESERVATION_TTL=24h
VIDEO_MIN_DURATION=15s
VIDEO_MAX_DURATION=30s
REQUIRE_WORKER=true
WORKER_STALE_AFTER=5m

# RevenueCat is the subscription authority. Configure the Flutter SDK with its
# platform-specific public key; only the secret key below belongs on the server.
REVENUECAT_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_APP_ID=
# Configure this exact value as the RevenueCat webhook Authorization header.
# Generate with: printf 'Bearer '; openssl rand -hex 32
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_WEBHOOK_TOLERANCE=5m
REVENUECAT_ALLOW_SANDBOX=false
REVENUECAT_TIMEOUT=10s
PRO_DAILY_SUBMISSION_LIMIT=1
PRO_MONTHLY_SUBMISSION_LIMIT=30
# Hard platform-wide cost ceiling across all subscribers, reset at 00:00 UTC.
GLOBAL_DAILY_SUBMISSION_LIMIT=100

MINIO_ROOT_USER=heatcheck-minio-admin
MINIO_ROOT_PASSWORD=
# Keep the named volume or set an absolute mounted block-storage path.
MINIO_DATA_PATH=minio-data

# S3-compatible storage. Endpoint values do not include http:// or https://.
S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=storage.heatcheck.dogi.watch
S3_ACCESS_KEY=heatcheck-api
S3_SECRET_KEY=
S3_BUCKET=heatcheck-clips
S3_REGION=us-east-1
S3_INTERNAL_USE_SSL=false
S3_PUBLIC_USE_SSL=true

# OpenAI is called only by the private worker container.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_VERIFICATION_MODEL=gpt-5.6-sol
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT=90s
AI_FRAME_COUNT=8
AI_MIN_CONFIDENCE=0.80

# Transactional email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=HeatCheck <no-reply@heatcheck.dogi.watch>
SAFETY_ALERT_EMAIL=
LEGAL_ALERT_EMAIL=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=30s

CLAMAV_ADDRESS=clamav:3310
CLAMAV_DATA_PATH=clamav-data
WORKER_POLL_INTERVAL=2s
WORKER_JOB_TIMEOUT=3m
