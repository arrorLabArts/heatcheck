APP_ENV=development
API_HOST_PORT=8088
DATABASE_URL=postgres://heatcheck:heatcheck@localhost:5432/heatcheck?sslmode=disable
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
MAX_UPLOAD_BYTES=104857600
MINIMUM_AGE=18
# S3-compatible storage. This may be self-hosted MinIO or Vultr Object Storage;
# AWS is not required. Endpoint values do not include http:// or https://.
UPLOAD_URL_TTL=15m
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=heatcheck
S3_SECRET_KEY=heatcheck-local-secret
S3_BUCKET=heatcheck-clips
S3_REGION=us-east-1
S3_INTERNAL_USE_SSL=false
S3_PUBLIC_USE_SSL=false
